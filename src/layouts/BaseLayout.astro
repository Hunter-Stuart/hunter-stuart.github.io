---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { htmlLanguage, localizedPath, otherLocale, type Locale } from '../i18n/config';
import { identity } from '../i18n/content';
import { socialLinks } from '../data/catalog';
import { getUi } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** 当前页面在另一种语言里的对应路径，用于语言切换与 hreflang */
  alternatePath?: string;
  noindex?: boolean;
  fullViewport?: boolean;
  /** 欢迎页这类单屏页不显示页脚 */
  standalone?: boolean;
  /** 页面类型：文章页传 'article'，社交平台与搜索引擎据此识别 */
  type?: 'website' | 'article';
  /** 分享缩略图，缺省用全站默认图 */
  image?: string;
  /** 文章发布时间（ISO 字符串），仅 type='article' 时有意义 */
  publishedTime?: string;
  /** 文章标签，仅 type='article' 时有意义 */
  tags?: string[];
}

const {
  locale,
  title = identity[locale].title,
  description = identity[locale].description,
  alternatePath,
  noindex = false,
  fullViewport = false,
  standalone = false,
  type = 'website',
  image = '/og-image.png',
  publishedTime,
  tags,
} = Astro.props;

const site = identity[locale];
const ui = getUi(locale);
const pageTitle = title === site.title ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const other = otherLocale(locale);
const strippedPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const otherHref = localizedPath(other, alternatePath ?? strippedPath);

/** 分享图的绝对地址——Open Graph 要求绝对 URL */
const origin = Astro.site ?? Astro.url.origin;
const ogImage = new URL(image, origin);
const siteName = identity[locale].name;

/**
 * 人物结构化数据：只在站首页输出。
 * 搜索引擎靠 sameAs 把「Hunter Stuart」这个名字和具体的人和账号连起来，
 * 是品牌词能被检索到的主要抓手之一。
 */
const personData =
  type === 'website'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: identity[locale].localName,
        alternateName: siteName,
        url: new URL(localizedPath(locale, '/'), origin).href,
        jobTitle:
          locale === 'zh' ? '通信工程本科生' : 'Undergraduate in Communications Engineering',
        affiliation: {
          '@type': 'CollegeOrUniversity',
          name:
            locale === 'zh'
              ? '电子科技大学'
              : 'University of Electronic Science and Technology of China',
        },
        knowsAbout: [
          'Signal Processing',
          'Telecommunications',
          'Embedded Systems',
          'Artificial Intelligence',
          'RF Engineering',
          'Astro',
        ],
        email: `mailto:${identity[locale].email}`,
        sameAs: socialLinks.map((link) => link.href),
      }
    : null;

/** 结构化数据：文章页给 Article，其余给 WebSite */
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: [ogImage.href],
        inLanguage: htmlLanguage[locale],
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        author: { '@type': 'Person', name: siteName, url: new URL(localizedPath(locale, '/profile'), origin).href },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
        ...(tags?.length ? { keywords: tags.join(', ') } : {}),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        description,
        url: new URL(localizedPath(locale, '/'), origin).href,
        inLanguage: htmlLanguage[locale],
      };
---

<!doctype html>
<html lang={htmlLanguage[locale]} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={htmlLanguage[locale].replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && (
      <meta property="article:author" content={siteName} />
    )}
    {type === 'article' && tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {personData && <script type="application/ld+json" set:html={JSON.stringify(personData)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang={htmlLanguage[locale]} href={canonical} />
    <link rel="alternate" hreflang={htmlLanguage[other]} href={new URL(otherHref, Astro.site ?? Astro.url.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('zh', alternatePath ?? '/'), Astro.site ?? Astro.url.origin)} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;

        // 明暗与画风各自独立存储，互不影响
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('orbit-theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch {
          // 存储不可用时沿用深色。
        }

        let art = 'oil';
        try {
          const storedArt = localStorage.getItem('orbit-art');
          if (storedArt === 'oil' || storedArt === 'ink') art = storedArt;
        } catch {
          // 同上。
        }

        root.dataset.art = art;
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
    {!standalone && <SiteHeader {locale} {otherHref} />}
    <slot />
    {!fullViewport && !standalone && <SiteFooter {locale} />}
  </body>
</html>
