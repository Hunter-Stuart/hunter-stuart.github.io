---
import WelcomePage from '../../components/WelcomePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { identity } from '../../i18n/content';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={identity[locale].title}
  standalone
  fullViewport
  alternatePath="/"
>
  <WelcomePage {locale} />
</BaseLayout>
