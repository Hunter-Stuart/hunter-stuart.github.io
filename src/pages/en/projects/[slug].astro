---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjectEntries, slugOf } from '../../../lib/content';
import { localizedPath } from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import '../../../styles/reading.css';

const locale = 'en' as const;
const ui = getUi(locale);

export async function getStaticPaths() {
  const entries = await getProjectEntries('en');
  return entries.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const dateFormat = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.summary}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  tags={entry.data.tags}
  alternatePath={`/projects/${slugOf(entry.id)}`}
>
  <main id="main-content" class="page">
    <div class="shell">
      <article class="article">
        <header class="article-head">
          <p class="eyebrow">PROJECT / {entry.data.status}</p>
          <h1>{entry.data.title}</h1>
          <p class="article-lede">{entry.data.summary}</p>
          <ul class="tag-list">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </header>

        <div class="article-project-meta">
          <div class="project-progress">
            <div class="stack-track">
              <span style={`--level:${entry.data.progress}%`} />
            </div>
            <span class="mono">{entry.data.progress}%</span>
          </div>
          <p class="mono">Started {dateFormat.format(entry.data.date)}{entry.data.updated && ` · updated ${dateFormat.format(entry.data.updated)}`}</p>
        </div>

        <div class="article-body">
          <div class="prose">
            <Content />
          </div>

          {toc.length > 1 && (
            <aside class="article-toc">
              <p class="mono">{ui.toc}</p>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ 'depth-3': heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </aside>
          )}
        </div>

        <footer class="article-foot">
          {entry.data.links.length > 0 && (
            <ul class="article-links">
              {entry.data.links.map((link) => (
                <li>
                  <a href={link.href} rel="noopener noreferrer" target="_blank">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          <a href={`${localizedPath(locale, '/blog')}#karman-line`}>
            {ui.backToPosts} <span aria-hidden="true">←</span>
          </a>
        </footer>
      </article>
    </div>
  </main>
</BaseLayout>
