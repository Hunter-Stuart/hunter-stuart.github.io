---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import '../styles/reading.css';

const locale: Locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const ui = getUi(locale);
---

<BaseLayout locale={locale} title={ui.notFoundTitle} description={ui.notFoundIntro} noindex>
  <main id="main-content" class="page">
    <div class="shell">
      <header class="page-head">
        <p class="eyebrow">SIGNAL LOST / 404</p>
        <h1>{ui.notFoundTitle}</h1>
        <p>{ui.notFoundIntro}</p>
      </header>
      <div class="article-foot">
        <a class="button button--solid" href={localizedPath(locale, '/')}>{ui.backToPad}</a>
        <a class="button" href={localizedPath(locale, '/posts')}>{ui.readPosts}</a>
      </div>
    </div>
  </main>
</BaseLayout>
