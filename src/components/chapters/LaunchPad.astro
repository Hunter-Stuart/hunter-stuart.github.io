---
import ChapterMarker from '../orbit/ChapterMarker.astro';
import LaunchPadScene from '../orbit/scenes/LaunchPadScene.astro';
import { chapters } from '../../data/orbit';
import { localizedPath, type Locale } from '../../i18n/config';
import { homeCopy, identity } from '../../i18n/content';
import { getUi } from '../../i18n/ui';
import type { PostSummary } from '../../lib/posts';

interface Props {
  locale: Locale;
  featured: PostSummary[];
}

const { locale, featured } = Astro.props;
const site = identity[locale];
const copy = homeCopy[locale];
const ui = getUi(locale);
const chapter = chapters[0];
const routes = chapters.slice(1);
const blogPath = localizedPath(locale, '/blog');
const postsPath = localizedPath(locale, '/posts');

const formatDate = (date: Date) =>
  date.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-GB', {
    month: '2-digit',
    day: '2-digit',
  });
---

<section
  class="orbit-panel"
  id={chapter.id}
  data-chapter={chapter.id}
  style="--slot:0"
  aria-labelledby="launch-pad-title"
>
  <div class="orbit-scene"><LaunchPadScene /></div>

  <div class="orbit-panel-inner">
    <ChapterMarker
      index={chapter.index}
      altitude={chapter.altitude}
      codename={copy.chapters[chapter.id].codename}
    />

    <div class="pad-stage">
      <div class="pad-copy">
        <p class="eyebrow" data-reveal>{site.kicker}</p>
        <h1 id="launch-pad-title" tabindex="-1" data-reveal>
          HUNTER <em>STUART</em>
        </h1>
        <p class="pad-local mono" data-reveal>{site.localName} · {site.location}</p>
        <p class="intro" data-reveal>{site.intro}</p>
        <blockquote class="pad-motto" data-reveal>「{site.motto}」</blockquote>
        <div class="pad-actions" data-reveal>
          <a class="button button--solid" href={blogPath}>
            {ui.readBlog}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button" href={postsPath}>
            {ui.readPosts}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="pad-featured" data-reveal>
        <div class="section-heading">
          <h3>{copy.featured}</h3>
          <span>{copy.featuredTag}</span>
        </div>
        <ul class="pad-featured-list">
          {featured.map((post) => (
            <li>
              <a href={`${postsPath}/${post.slug}`}>
                <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                <strong>{post.title}</strong>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="pad-routes" aria-label={ui.dockLabel} data-reveal>
      {routes.map((route) => (
        <a
          href={`${blogPath}#${route.id}`}
          style={`--route-accent: var(--accent-${route.id})`}
        >
          <i aria-hidden="true" />
          <small>{route.index} · {route.altitude}</small>
          <strong>{copy.chapters[route.id].name}</strong>
        </a>
      ))}
    </nav>
  </div>
</section>
