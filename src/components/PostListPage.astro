---
import { localizedPath, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import type { PostSummary } from '../lib/posts';

interface Props {
  locale: Locale;
  posts: PostSummary[];
}

const { locale, posts } = Astro.props;
const ui = getUi(locale);
const postsPath = localizedPath(locale, '/posts');

const groups = new Map<string, PostSummary[]>();
for (const post of posts) {
  const key = post.date.getFullYear().toString();
  groups.set(key, [...(groups.get(key) ?? []), post]);
}

const formatDate = (date: Date) => date.toISOString().slice(5, 10).replace('-', '.');
---

<main id="main-content" class="page">
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">FLIGHT LOG / ALL ENTRIES</p>
      <h1>{ui.postsIndexTitle}</h1>
      <p>{ui.postsIndexIntro(posts.length)}</p>
    </header>

    {[...groups.entries()].map(([year, entries]) => (
      <section class="year-block">
        <div class="year-heading">
          <h2>{year}</h2>
          <span class="mono">{ui.entries(entries.length)}</span>
        </div>
        <ul class="archive-list">
          {entries.map((post) => (
            <li>
              <a href={`${postsPath}/${post.slug}`}>
                <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                <strong>{post.title}</strong>
                <span>{post.category}</span>
              </a>
              {post.description && <p>{post.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    {posts.length === 0 && <p class="empty">{ui.empty}</p>}
  </div>
</main>
