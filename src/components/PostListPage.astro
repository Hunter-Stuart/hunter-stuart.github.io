---
import { localizedPath, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import type { PostSummary } from '../lib/posts';
import type { NoteSummary } from '../lib/content';

interface Props {
  locale: Locale;
  posts: PostSummary[];
  notes: NoteSummary[];
  projects: { slug: string; title: string; summary: string; status: string; date: Date }[];
}

const { locale, posts, notes, projects } = Astro.props;
const ui = getUi(locale);

/** 三类内容归一成同一种形状，渲染逻辑只写一遍 */
interface Entry {
  title: string;
  date: Date;
  category: string;
  description: string;
  href: string;
}

const toEntry = (href: string) => (item: {
  title: string;
  date: Date;
  category: string;
  description: string;
}): Entry => ({ ...item, href });

const groups: { id: string; label: string; items: Entry[]; empty: string }[] = [
  {
    id: 'projects',
    label: ui.tabProjects,
    empty: ui.noProjects,
    items: projects.map((project) => ({
      title: project.title,
      date: project.date,
      category: project.status,
      description: project.summary,
      href: localizedPath(locale, `/projects/${project.slug}`),
    })),
  },
  {
    id: 'posts',
    label: ui.tabPosts,
    empty: ui.empty,
    items: posts.map((post) =>
      toEntry(localizedPath(locale, `/posts/${post.slug}`))({
        title: post.title,
        date: post.date,
        category: post.category,
        description: post.description,
      }),
    ),
  },
  {
    id: 'notes',
    label: ui.tabNotes,
    empty: ui.noNotes,
    items: notes.map((note) =>
      toEntry(localizedPath(locale, `/notes/${note.slug}`))({
        title: note.title,
        date: note.date,
        category: note.category,
        description: note.description,
      }),
    ),
  },
];

/** 按年份分组 */
function byYear(items: Entry[]) {
  const map = new Map<string, Entry[]>();
  for (const item of items) {
    const key = item.date.getFullYear().toString();
    map.set(key, [...(map.get(key) ?? []), item]);
  }
  return [...map.entries()];
}

const formatDate = (date: Date) => date.toISOString().slice(5, 10).replace('-', '.');
const total = posts.length + notes.length + projects.length;
---

<main id="main-content" class="page page-archive">
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">ARCHIVE / ALL ENTRIES</p>
      <h1>{ui.postsIndexTitle}</h1>
      <p>{ui.postsIndexIntro(total)}</p>
    </header>

    <div class="archive-bar">
      <div class="archive-tabs" role="tablist" aria-label={ui.postsIndexTitle} data-tabs>
      {groups.map((group, index) => (
        <button
          type="button"
          role="tab"
          id={`archive-tab-${group.id}`}
          aria-controls={`archive-panel-${group.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-tab={group.id}
        >
          <span class="archive-tab-label">{group.label}</span>
          <b class="archive-tab-count mono">{String(group.items.length).padStart(2, '0')}</b>
          </button>
        ))}
      </div>

      <button
        type="button"
        class="archive-sort"
        data-sort-toggle
        data-desc={ui.sortDesc}
        data-asc={ui.sortAsc}
        aria-label={ui.sortLabel}
      >
        {ui.sortDesc} <span aria-hidden="true">↓</span>
      </button>
    </div>

    {groups.map((group, index) => (
      <div
        role="tabpanel"
        id={`archive-panel-${group.id}`}
        aria-labelledby={`archive-tab-${group.id}`}
        data-panel={group.id}
        hidden={index !== 0}
      >
        {group.items.length === 0 ? (
          <p class="empty">{group.empty}</p>
        ) : (
          byYear(group.items).map(([year, entries]) => (
            <section class="year-block" data-year={year}>
              <div class="year-heading">
                <h2>{year}</h2>
                <span class="mono">{ui.entries(entries.length)}</span>
              </div>
              <ul class="archive-list">
                {entries.map((entry) => (
                  <li data-date={entry.date.toISOString()}>
                    <a href={entry.href}>
                      <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
                      <strong>{entry.title}</strong>
                      <span>{entry.category}</span>
                    </a>
                    {entry.description && <p>{entry.description}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))
        )}
      </div>
    ))}

    <noscript>
      <style>
        /* 没有 JS 时三个列表全部展开，内容不会丢 */
        [data-panel][hidden] {
          display: block;
        }
        .archive-tabs {
          display: none;
        }
      </style>
    </noscript>
  </div>
</main>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');

  if (root) {
    const tablist = root;
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [
      ...document.querySelectorAll<HTMLElement>('[data-panel]'),
    ];

    const activate = (id: string, focus = false) => {
      for (const tab of tabs) {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panel !== id;
      }
      // 切换写进 URL，刷新或分享链接能停在同一页
      if (location.hash !== `#${id}`) {
        history.replaceState(null, '', `#${id}`);
      }
    };

    tablist.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
      if (tab?.dataset.tab) activate(tab.dataset.tab);
    });

    // 方向键 / Home / End 在标签间移动
    tablist.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      if (current < 0) return;

      let next = current;
      if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;

      event.preventDefault();
      const target = tabs[next]?.dataset.tab;
      if (target) activate(target, true);
    });

    // 直接带 hash 打开时落到对应列表
    const initial = location.hash.slice(1);
    if (initial && tabs.some((tab) => tab.dataset.tab === initial)) {
      activate(initial);
    }
  }

  /* ---------- 排序：倒序 / 正序 ---------- */

  const sortToggle = document.querySelector<HTMLButtonElement>('[data-sort-toggle]');

  if (sortToggle) {
    // 服务端已经按日期倒序渲染，所以初始状态就是倒序
    let descending = true;

    const paint = () => {
      const label = descending ? sortToggle.dataset.desc : sortToggle.dataset.asc;
      sortToggle.replaceChildren(`${label ?? ''} `);
      const arrow = document.createElement('span');
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = descending ? '↓' : '↑';
      sortToggle.append(arrow);
    };

    const applySort = () => {
      // 日期是 ISO 字符串，字典序即时间序
      const compare = (a: string, b: string) => (descending ? b.localeCompare(a) : a.localeCompare(b));

      for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
        const sections = [...panel.querySelectorAll<HTMLElement>('.year-block')];
        sections.sort((a, b) => compare(a.dataset.year ?? '', b.dataset.year ?? ''));

        for (const section of sections) {
          const list = section.querySelector<HTMLElement>('.archive-list');
          if (list) {
            const items = [...list.children] as HTMLElement[];
            items.sort((a, b) => compare(a.dataset.date ?? '', b.dataset.date ?? ''));
            for (const item of items) list.append(item);
          }
          // 按排好的顺序把年份区块放回面板
          panel.append(section);
        }
      }

      paint();
    };

    sortToggle.addEventListener('click', () => {
      descending = !descending;
      applySort();
    });
  }
</script>
