---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="icon-button" type="button" aria-label={label} title={label} data-theme-toggle>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
    <circle class="theme-sun" cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
    <g class="theme-rays" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
    </g>
    <path class="theme-moon" d="M12 3.2a8.8 8.8 0 1 0 8.6 10.7A7 7 0 0 1 12 3.2Z" stroke="currentColor" stroke-width="1.6" />
  </svg>
</button>

<style>
  /* 深色主题显示太阳（点了会变亮），浅色主题显示月亮。 */
  .theme-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-moon {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-sun,
  :global(:root[data-theme='dark']) .theme-rays {
    display: none;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    root.style.colorScheme = next;

    try {
      localStorage.setItem('orbit-theme', next);
    } catch {
      // 存储失败也不影响本次切换。
    }
  });
</script>
