---
import ThemeToggle from './ThemeToggle.astro';
import ArtToggle from './ArtToggle.astro';
import { htmlLanguage, localeLabel, localizedPath, locales, type Locale } from '../i18n/config';
import { identity, welcomeCopy } from '../i18n/content';
import { getUi } from '../i18n/ui';
import '../styles/welcome.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = identity[locale];
const copy = welcomeCopy[locale];
const ui = getUi(locale);
const profileHref = localizedPath(locale, '/profile');
const blogHref = localizedPath(locale, '/blog');
---

<div class="welcome">
  <div class="welcome-bg" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <g class="welcome-star">
        <circle cx="168" cy="132" r="1.5"></circle>
        <circle cx="332" cy="78" r="1.1"></circle>
        <circle cx="512" cy="164" r="1.2"></circle>
        <circle cx="706" cy="96" r="1.4"></circle>
        <circle cx="884" cy="176" r="1"></circle>
        <circle cx="1048" cy="88" r="1.3"></circle>
        <circle cx="1236" cy="158" r="1.1"></circle>
        <circle cx="1360" cy="72" r="1.4"></circle>
        <circle cx="248" cy="288" r="1"></circle>
        <circle cx="1180" cy="316" r="1"></circle>
      </g>

      <!-- 地平线 -->
      <path class="welcome-horizon" d="M-40 892C240 852 470 786 720 786s480 66 760 106"></path>
      <path class="welcome-horizon welcome-horizon--faint" d="M-40 866C250 826 480 754 720 754s470 72 760 112"></path>

      <!-- 两条上升路径 -->
      <path class="welcome-route" d="M236 900C360 760 470 610 596 468"></path>
      <path class="welcome-route welcome-route--alt" d="M1204 900C1080 760 970 610 844 468"></path>

      <g class="welcome-dot">
        <circle cx="596" cy="468" r="4"></circle>
        <circle cx="844" cy="468" r="4"></circle>
      </g>

      <!-- 地平线上的探照灯 -->
      <g class="welcome-beam">
        <path d="M720 786 636 402 812 402Z" opacity="0.06"></path>
        <path d="M720 786 690 430 756 430Z" opacity="0.1"></path>
      </g>
    </svg>
  </div>

  <div class="welcome-shell">
    <header class="welcome-header">
      <a class="welcome-brand" href={localizedPath(locale, '/')} aria-label={site.name}>
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M16 3.5 21 9.5v8l-5 6-5-6v-8L16 3.5Z" stroke="currentColor" stroke-width="1.2" />
          <path d="M16 3.5v20" stroke="currentColor" stroke-width="0.9" opacity=".55" />
          <path d="M4.5 26.5h23" stroke="currentColor" stroke-width="1.2" opacity=".35" />
        </svg>
        <span>
          {site.name}
          <small>{site.kicker}</small>
        </span>
      </a>

      <div class="welcome-actions">
        <span class="mono welcome-location">{site.location}</span>
        <a class="mono welcome-friends" href={localizedPath(locale, '/friends')}>
          {ui.nav.friends}
          <span aria-hidden="true">↗</span>
        </a>
        <nav class="welcome-langs" aria-label={ui.language}>
          {locales.map((item) => (
            <a
              href={localizedPath(item, '/')}
              lang={htmlLanguage[item]}
              aria-current={locale === item ? 'page' : undefined}
            >
              {localeLabel[item]}
            </a>
          ))}
        </nav>
        <ArtToggle label={ui.art} />
        <ThemeToggle label={ui.theme} />
      </div>
    </header>

    <main class="welcome-main" id="main-content" tabindex="-1">
      <div class="welcome-host" data-reveal>

        <span>{copy.greeting} <strong>{site.localName} / {site.name}</strong></span>
        <i aria-hidden="true"></i>
        <span>{copy.welcome}</span>
      </div>

      <div class="welcome-intro" data-reveal>
        <p class="mono welcome-overline">{copy.overline}</p>
        <h1 id="welcome-title">
          {copy.title.split('|').map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </h1>
        <p class="welcome-lede">
          {copy.intro.map((line) => <span>{line}</span>)}
        </p>
      </div>

      <p class="welcome-divider" aria-hidden="true" data-reveal>{copy.divider}</p>

      <div class="welcome-choices" data-reveal>
        <a class="choice choice--profile" href={profileHref} data-choice="profile">
          <span class="choice-top">
            <svg class="choice-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M5 6h24l6 6v23H5V6Z" fill="currentColor" opacity=".08" />
              <path d="M5 6h24l6 6v23H5V6Zm24 0v7h6" stroke="currentColor" />
              <path d="M10 23l4-8 4 8-4 3-4-3Z" fill="currentColor" opacity=".5" />
              <path d="M23 18h7m-7 5h7M10 30h20" stroke="currentColor" />
            </svg>
            <span class="mono">{copy.resumeId}</span>
          </span>
          <h2>{copy.resumeTitle}</h2>
          <p>{copy.resumeLines.map((line) => <span>{line}</span>)}</p>
          <span class="choice-bottom mono">
            {copy.resumeCta}
            <i aria-hidden="true">↗</i>
          </span>
        </a>

        <span class="welcome-choice-divider" aria-hidden="true"></span>

        <a class="choice choice--blog" href={blogHref} data-choice="blog">
          <span class="choice-top">
            <svg class="choice-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M6 8h11v24H6zM23 8h11v24H23z" fill="currentColor" opacity=".08" />
              <path d="M6 8h11v24H6zM23 8h11v24H23z" stroke="currentColor" />
              <path d="M20 12v20M10 15h3M10 20h3M27 15h3M27 20h3" stroke="currentColor" opacity=".7" />
            </svg>
            <span class="mono">{copy.blogId}</span>
          </span>
          <h2>{copy.blogTitle}</h2>
          <p>{copy.blogLines.map((line) => <span>{line}</span>)}</p>
          <span class="choice-bottom mono">
            {copy.blogCta}
            <i aria-hidden="true">↗</i>
          </span>
        </a>
      </div>

      <p class="welcome-hint mono" data-reveal>{copy.hint}</p>
    </main>

    <footer class="welcome-footer">
      <div>
        <p class="mono">{copy.footerLeft}</p>
        <p>{copy.footerLeftSub}</p>
      </div>
      <div>
        <p class="mono">{copy.footerRight}</p>
        <p>{copy.footerRightSub}</p>
      </div>
    </footer>
  </div>
</div>
