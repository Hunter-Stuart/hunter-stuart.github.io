---
import Starfield from '../Starfield.astro';
import Rocket from '../Rocket.astro';
import { orbitVars, tracks } from '../../../data/tracks';

// 06 月球以远 · 384,400 KM —— 月球、银河带，以及一枚还在往外飞的探测器。
const track = tracks['deep-space'];
const orbit = track.orbit!;
---

<svg
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- 银河带 -->
  <path
    class="scene-line scene-line--faint"
    d="M-60 760C240 640 460 470 720 330s520-260 780-320"
    stroke-width="46"
    opacity="0.06"
  ></path>
  <path
    class="scene-line scene-line--faint"
    d="M-60 792C260 664 486 500 748 356s524-262 782-316"
    stroke-width="18"
    opacity="0.1"
  ></path>

  <!-- 星野 -->
  <Starfield count={165} seed={97} />

  <!-- 月球 -->
  <circle class="scene-fill" cx="1150" cy="560" r="186"></circle>
  <g class="scene-line">
    <circle cx="1150" cy="560" r="186"></circle>
    <path d="M1046 470a54 54 0 0 0 72 62"></path>
    <path d="M1206 640a40 40 0 0 0 66 12"></path>
    <path d="M1108 630a26 26 0 0 0 34 26"></path>
    <path d="M1240 470a22 22 0 0 0 24 24"></path>
  </g>

  <!-- 探测器 -->
  <g class="scene-line">
    <path d="M470 610 540 610"></path>
    <path d="M470 596v28M540 596v28"></path>
    <path d="M505 610v-58M505 552 470 522M505 552 540 522"></path>
    <path d="M470 502 540 502M505 486v-18"></path>
    <path d="M505 610v46M492 656h26"></path>
  </g>
  <circle class="scene-dot" cx="505" cy="520" r="2.6"></circle>

  <!-- 轨道环：卫星就在这条虚线上环绕 -->
  <ellipse
    class="scene-track"
    cx={orbit.cx}
    cy={orbit.cy}
    rx={orbit.rx}
    ry={orbit.ry}
    transform={`rotate(${orbit.tilt} ${orbit.cx} ${orbit.cy})`}></ellipse>

  <!-- 运载器：沿椭圆轨道连续环绕（旋转带动 + 反向旋转保持姿态） -->
  <g class="rocket-mover" data-mode="orbit">
    <g class="orbit-anchor" style={orbitVars(orbit, track.scale)}>
      <g class="orbit-squash">
        <g class="orbit-spin">
          <g class="orbit-slot">
            <g class="orbit-unsquash">
              <g class="orbit-counter">
                <g class="orbit-craft">
                  <Rocket stage={6} />
                </g>
              </g>
            </g>
          </g>
        </g>
      </g>
    </g>
  </g>
</svg>
