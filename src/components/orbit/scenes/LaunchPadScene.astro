---
import Rocket from '../Rocket.astro';
import { dockVars, pathOf, tracks } from '../../../data/tracks';

// 01 发射台 · 0 KM —— 塔架、待发的运载器、点火辉光与透视地面网格。
const track = tracks['launch-pad'];
---

<svg
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- 高空残留的几颗星 -->
  <g class="scene-star">
    <circle cx="212" cy="132" r="1.6"></circle>
    <circle cx="486" cy="86" r="1.2"></circle>
    <circle cx="948" cy="118" r="1.3"></circle>
    <circle cx="1268" cy="196" r="1.1"></circle>
  </g>

  <!-- 地平线与透视网格 -->
  <path class="scene-line" d="M0 744h1440"></path>
  <g class="scene-line scene-line--faint">
    <path d="M0 790h1440M0 838h1440M0 888h1440"></path>
    <path d="M180 744 40 900M420 744 372 900M700 744 700 900M980 744 1030 900M1220 744 1360 900"></path>
  </g>

  <!-- 塔架：紧贴运载器右侧 -->
  <g class="scene-line">
    <path d="M876 744V436M932 744V396M876 436h56M876 500h56M876 564h56M876 628h56M876 692h56"></path>
    <path d="M904 396V316M904 316h-36"></path>
  </g>

  <!-- 点火辉光：落在运载器尾部 -->
  <g fill="currentColor">
    <circle cx="820" cy="726" r="86" opacity="0.06"></circle>
    <circle cx="820" cy="726" r="50" opacity="0.1"></circle>
    <circle cx="820" cy="726" r="24" opacity="0.18"></circle>
  </g>

  <!-- 轨道：从发射台垂直升起的虚线 -->
  <path class="scene-track" d={pathOf(track.curve!)}></path>

  <!-- 运载器：页面打开时从地面点火升到悬停点 -->
  <g class="rocket-mover" data-mode="static" style={dockVars(track)}>
    <Rocket stage={1} />
  </g>
</svg>
