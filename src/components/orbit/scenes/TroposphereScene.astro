---
import Rocket from '../Rocket.astro';
import { dockVars, pathOf, tracks } from '../../../data/tracks';

// 02 对流层 · 12 KM —— 云层带、风切变线与穿云而上的轨道。
const track = tracks['troposphere'];
---

<svg
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g class="scene-star">
    <circle cx="316" cy="96" r="1.4"></circle>
    <circle cx="702" cy="58" r="1.1"></circle>
    <circle cx="1044" cy="122" r="1.3"></circle>
  </g>

  <!-- 云层带 -->
  <g class="scene-line">
    <path d="M0 620c120-36 208-12 320 6s214 4 320-18 232-34 352-8 288 26 448-16"></path>
    <path d="M0 700c146-30 232-4 364 10s226 0 344-22 250-22 372 4 236 20 360-12"></path>
  </g>
  <g class="scene-line scene-line--faint">
    <path d="M0 664c130-28 214-6 338 8s238 2 356-18 246-26 366 0 230 22 380-14"></path>
    <path d="M0 762c150-24 244 0 372 12s240-4 356-24 252-18 372 6 234 18 340-8"></path>
    <path d="M0 828c160-20 250 2 380 12s246-6 362-26 258-14 378 8 224 14 320-6"></path>
  </g>

  <!-- 风切变 -->
  <g class="scene-line scene-line--faint">
    <path d="M120 470h250M470 470l-18-16M470 470l-18 16"></path>
    <path d="M980 420h280M1260 420l-18-16M1260 420l-18 16"></path>
  </g>

  <!-- 轨道：压弯穿云的虚线 -->
  <path class="scene-track" d={pathOf(track.curve!)}></path>

  <!-- 运载器：沿上升轨道单向划过，首尾淡入淡出 -->
  <g class="rocket-mover" data-mode="climb" style={dockVars(track)}>
    <g class="rocket-climb">
      <Rocket stage={2} />
    </g>
  </g>
</svg>
