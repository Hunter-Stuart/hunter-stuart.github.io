---
import ThemeToggle from './ThemeToggle.astro';
import ArtToggle from './ArtToggle.astro';
import { localizedPath, localeLabel, otherLocale, type Locale } from '../i18n/config';
import { identity } from '../i18n/content';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
  otherHref: string;
}

const { locale, otherHref } = Astro.props;
const ui = getUi(locale);
const site = identity[locale];

const items = [
  { label: ui.nav.home, href: localizedPath(locale, '/') },
  { label: ui.nav.blog, href: localizedPath(locale, '/blog') },
  { label: ui.nav.profile, href: localizedPath(locale, '/profile') },
  { label: ui.nav.posts, href: localizedPath(locale, '/posts') },
  { label: ui.nav.friends, href: localizedPath(locale, '/friends') },
  { label: ui.nav.tools, href: localizedPath(locale, '/tools') },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const home = localizedPath(locale, '/');
  return href === home ? pathname === home || pathname === '/' : pathname === href;
};
---

<header class="site-header">
  <div class="site-header-inner shell">
    <a class="brand" href={localizedPath(locale, '/')} aria-label={site.name}>
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M16 3.5 21 9.5v8l-5 6-5-6v-8L16 3.5Z" stroke="currentColor" stroke-width="1.2" />
        <path d="M16 3.5v20" stroke="currentColor" stroke-width="0.9" opacity=".55" />
        <path d="M4.5 26.5h23" stroke="currentColor" stroke-width="1.2" opacity=".35" />
        <path d="M9 15.5c4.2-2.6 9.8-2.6 14 0" stroke="currentColor" stroke-width="0.9" opacity=".7" />
      </svg>
      <span>
        {site.name}
        <small>{site.kicker}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label={ui.navLabel}>
      {items.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="lang-link"
        href={otherHref}
        aria-label={ui.language}
        hreflang={otherLocale(locale)}
        rel="alternate"
      >
        {localeLabel[otherLocale(locale)]}
      </a>
      <ArtToggle label={ui.art} />
      <ThemeToggle label={ui.theme} />
      <button
        class="icon-button menu-toggle"
        type="button"
        aria-label={ui.menuOpen}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label={ui.mobileNavLabel} hidden>
    {items.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href={otherHref} hreflang={otherLocale(locale)}>{localeLabel[otherLocale(locale)]}</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).tagName === 'A') setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
